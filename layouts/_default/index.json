{{- $index := slice -}}
{{- $counter := 0 -}}

{{- range where .Site.RegularPages "Layout" "postingan-donghua" -}}
  {{/* UI dinamis (search, favorit, filter genre, recently viewed) memakai varian
       400x600 Smart yang sama dengan partial donghua-card, supaya poster tampil
       identik di card statis maupun card hasil render JS. */}}
  {{- $thumb := .Params.thumbnail | default "" -}}
  {{- with $thumb -}}
    {{- $clean := strings.TrimPrefix "/" . -}}
    {{- with resources.Get $clean -}}
      {{- with try (.Fill "400x600 Smart webp") -}}
        {{- with .Err -}}{{- warnf "index.json: gagal resize %q (%s)" $clean . -}}{{- else -}}{{- $thumb = .Value.RelPermalink -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $item := dict
      "objectID" $counter
      "title" .Title
      "studio" .Params.studio
      "season" .Params.season
      "genre" (delimit .Params.genre ", ")
      "permalink" .Permalink
      "thumbnail" $thumb
      "type" (.Params.type | default "Donghua")
      "sub" (.Params.sub | default "Sub")
      "episode" (.Params.episode | default "")
      "status" (.Params.status | default "")
      "rating" (.Params.rating | default "")
      "date" (.Date.Format "2006-01-02T15:04:05Z07:00")
  -}}
  {{- $index = $index | append $item -}}
  {{- $counter = add $counter 1 -}}
{{- end -}}

{{- $index | jsonify -}}
