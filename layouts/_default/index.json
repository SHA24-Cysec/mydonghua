{{- $index := slice -}}
{{- $halaman := partialCached "urutan-terbaru" (where .Site.RegularPages "Layout" "postingan-donghua") "beranda" -}}

{{- range $halaman -}}
  {{- $waktuUpdate := partial "waktu-update" . -}}
  {{- $thumb := .Params.thumbnail | default "" -}}
  {{- $item := dict
      "title" .Title
      "studio" .Params.studio
      "season" .Params.season
      "genre" (delimit .Params.genre ", ")
      "permalink" .Permalink
      "thumbnail" $thumb
      "type" (.Params.type | default "Donghua")
      "episode" (.Params.episode | default "")
      "status" (.Params.status | default "")
      "rating" (.Params.rating | default "")
      "date" (.PublishDate.Format "2006-01-02T15:04:05Z07:00")
      "lastmod" ($waktuUpdate.Format "2006-01-02T15:04:05Z07:00")
  -}}
  {{- $index = $index | append $item -}}
{{- end -}}

{{- $index | jsonify -}}
