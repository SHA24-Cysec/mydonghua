{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": "hugo",
  "trailingSlash": true,
  "installCommand": "npm ci",
  "build": {
    "env": {
      "HUGO_VERSION": "0.164.0"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://bendspecimen.com https://safelinku.com https://mydonghua.disqus.com https://*.disqus.com https://c.disquscdn.com https://d-code.liadm.com; style-src 'self' 'unsafe-inline' https://c.disquscdn.com; img-src 'self' data: https://*.disqus.com https://c.disquscdn.com https://referrer.disqus.com https://*.google-analytics.com https://www.googletagmanager.com https://bendspecimen.com https://*.disquscdn.com https://cdn.viglink.com https://rp.liadm.com; font-src 'self'; connect-src 'self' https://cloudflare-dns.com https://dns.google https://*.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://*.disqus.com https://bendspecimen.com https://rp.liadm.com; frame-src 'self' https://*.disqus.com https://disqus.com https://bendspecimen.com https://i.liadm.com; form-action https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; manifest-src 'self'; worker-src 'self'; report-uri /api/csp-report; report-to csp-lapor" },
        { "key": "Reporting-Endpoints", "value": "csp-lapor=\"/api/csp-report\"" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*).min.(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/post", "destination": "/", "permanent": true },
    { "source": "/post/", "destination": "/", "permanent": true },
    { "source": "/post/page/:path*", "destination": "/", "permanent": true },
    { "source": "/post/index.xml", "destination": "/", "permanent": true },
    { "source": "/halaman", "destination": "/", "permanent": true },
    { "source": "/halaman/", "destination": "/", "permanent": true },
    { "source": "/halaman/index.xml", "destination": "/", "permanent": true },
    { "source": "/genre", "destination": "/", "permanent": true },
    { "source": "/genre/", "destination": "/", "permanent": true },
    { "source": "/genre/index.xml", "destination": "/", "permanent": true },
    { "source": "/genre/-", "destination": "/", "permanent": true },
    { "source": "/genre/-/", "destination": "/", "permanent": true },
    { "source": "/genre/-/index.xml", "destination": "/", "permanent": true },
    { "source": "/studio", "destination": "/", "permanent": true },
    { "source": "/studio/", "destination": "/", "permanent": true },
    { "source": "/studio/index.xml", "destination": "/", "permanent": true },
    { "source": "/studio/-", "destination": "/", "permanent": true },
    { "source": "/studio/-/", "destination": "/", "permanent": true },
    { "source": "/studio/-/index.xml", "destination": "/", "permanent": true },
    { "source": "/season", "destination": "/", "permanent": true },
    { "source": "/season/", "destination": "/", "permanent": true },
    { "source": "/season/index.xml", "destination": "/", "permanent": true },
    { "source": "/season/-", "destination": "/", "permanent": true },
    { "source": "/season/-/", "destination": "/", "permanent": true },
    { "source": "/season/-/index.xml", "destination": "/", "permanent": true },
    { "source": "/season/2d-animation", "destination": "/", "permanent": true },
    { "source": "/season/2d-animation/", "destination": "/", "permanent": true },
    { "source": "/season/2d-animation/index.xml", "destination": "/", "permanent": true },
    { "source": "/season/3d-animation", "destination": "/", "permanent": true },
    { "source": "/season/3d-animation/", "destination": "/", "permanent": true },
    { "source": "/season/3d-animation/index.xml", "destination": "/", "permanent": true },
    {
      "source": "/prince,dont-do-this/",
      "destination": "/prince-dont-do-this/",
      "permanent": true
    },
    {
      "source": "/tales-of-demons-of-gods-season-4/",
      "destination": "/tales-of-demons-and-gods-season-4/",
      "permanent": true
    },
    {
      "source": "/tales-of-demons-of-gods-season-5-dan-6/",
      "destination": "/tales-of-demons-and-gods-season-5-dan-6/",
      "permanent": true
    },
    {
      "source": "/tales-of-demons-of-gods-season-7/",
      "destination": "/tales-of-demons-and-gods-season-7/",
      "permanent": true
    },
    {
      "source": "/chinesse-mystery-man/",
      "destination": "/chinese-mystery-man/",
      "permanent": true
    }
  ]
}
